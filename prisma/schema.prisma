datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("member")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LineGroup {
  id                      String        @id
  name                    String
  avatarColor             String
  unreadCount             Int           @default(0)
  lastActive              String
  membersCount            Int
  syncStatus              String        @default("idle")
  lastSynced              String
  rawChat                 String        @db.LongText
  syncError               String?       @db.Text
  
  // Stats
  messagesToday           Int           @default(0)
  messagesChange          Int           @default(0)
  activeContributorsCount Int           @default(0)
  sentiment               String        @default("Neutral")
  sentimentScore          Int           @default(50)
  
  // Summary
  summaryOverall          String?       @db.Text
  summaryMorning          String?       @db.Text
  summaryAfternoon        String?       @db.Text
  summaryEvening          String?       @db.Text

  // JSON fields
  hourlyActivity          Json?         // Stores [number, number, ...] array

  // Relations
  contributors            Contributor[]
  actionItems             ActionItem[]
  topics                  Topic[]
}

model Contributor {
  id            Int       @id @default(autoincrement())
  groupId       String
  group         LineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  messagesCount Int
  avatarColor   String
}

model ActionItem {
  id        String    @id
  groupId   String
  group     LineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  task      String    @db.Text
  assignee  String
  status    String    @default("pending") // "pending" | "completed"
  dueDate   String?
}

model Topic {
  id        Int       @id @default(autoincrement())
  groupId   String
  group     LineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  category  String    // "urgent" | "work" | "finance" | "social" | "general"
  relevance Int
  keyPoints Json      // Stores array of strings ["key point 1", "key point 2"]
}

model SystemLog {
  id        String   @id @default(cuid())
  type      String   // "webhook" | "ai_summary" | "cron" | "system"
  level     String   // "info" | "warning" | "error"
  message   String   @db.Text
  details   String?  @db.LongText
  timestamp DateTime @default(now())
}

model SystemSetting {
  id                      Int      @id @default(1)
  geminiApiKeyEnc         String?  @db.Text
  lineChannelSecretEnc    String?  @db.Text
  lineAccessTokenEnc      String?  @db.Text
  updatedAt               DateTime @updatedAt
}
